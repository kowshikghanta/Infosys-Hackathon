# Qualcomm Cloud AI / Cirrascale Inference Cloud Configuration
# Direct match for: https://aisuite.cirrascale.com/account/api-keys
# Never commit real credentials to version control.

# 1. Cirrascale Inference Cloud Credentials (from your dashboard)
INFERENCE_CLOUD_API_KEY=your_copied_api_key_here
INFERENCE_CLOUD_ENDPOINT=https://aisuite.cirrascale.com/apis/v2

# 2. Model Identifier (as documented on Cirrascale)
QUALCOMM_MODEL_NAME=llama-3.1-8B

# 3. Request Timeout in seconds (default: 45)
QUALCOMM_TIMEOUT_SECONDS=45

# -------------------------------------------------------------
# Optional Synonyms (Also supported automatically):
# QUALCOMM_API_KEY=your_key_here
# QUALCOMM_API_BASE_URL=https://aisuite.cirrascale.com/apis/v2
# IMAGINE_API_KEY=your_key_here
# IMAGINE_ENDPOINT_URL=https://aisuite.cirrascale.com/apis/v2
